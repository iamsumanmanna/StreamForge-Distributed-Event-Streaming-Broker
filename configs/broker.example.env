# StreamForge Distributed Event Streaming Broker — example environment
SF_NODE_ID=broker-1
SF_LISTEN=:9092
SF_HTTP=:8080
SF_DATA=./data/broker-1
SF_SEGMENT_BYTES=67108864
SF_FSYNC_INTERVAL=50ms
SF_FSYNC_EVERY=1000
SF_RETENTION_BYTES=1073741824
SF_RETENTION_AGE=168h
SF_ACKS=-1
SF_COMPRESSION=none
